# Maintainer: Core Language <packages@core-lang.example>
# AUR package `core-lang` — install with: yay -S core-lang
pkgname=core-lang
pkgver=0.1.0
pkgrel=1
pkgdesc="Core compiled systems programming language (LLVM backend)"
arch=('x86_64')
url="https://github.com/snitchbossdotcom/corelang"
license=('MIT')
provides=('core')
conflicts=('core')
depends=('gcc' 'zlib' 'zstd' 'ncurses')
source=("core-0.1.0-linux-x86_64.tar.gz::http://94.24.39.227/dl/core-0.1.0-linux-x86_64.tar.gz")
sha256sums=('97145174e30e6c1d47f7b6497d28c0c6f29d9cf26a6fa91319964d6c0f564425')

package() {
  install -Dm755 bin/core "$pkgdir/usr/bin/core"
  install -Dm755 bin/corepkg "$pkgdir/usr/bin/corepkg"
  install -Dm644 lib/core/corert.o "$pkgdir/usr/lib/core/corert.o"
  mkdir -p "$pkgdir/usr/lib/core/std"
  install -Dm644 lib/core/std/*.cr -t "$pkgdir/usr/lib/core/std/"
}
